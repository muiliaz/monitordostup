    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0"
  }
}
