# --- Admin (single account for dashboard & settings) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Secret for signing the session cookie. Change it for anything non-local.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Postgres ---
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor

# --- SMTP (MailDev inside docker-compose) ---
SMTP_HOST=maildev
SMTP_PORT=1025
MAIL_FROM=monitor@localhost
# Alerts for checks in a group go to that group's addresses (set in the UI).
# Checks without a group alert these addresses (comma-separated, may be empty).
DEFAULT_ALERT_EMAILS=admin@example.com
# Time zone for times in alert emails (IANA name, e.g. Europe/Moscow, Asia/Almaty).
DISPLAY_TIMEZONE=UTC

# --- Public URL of the frontend (used in email links) ---
PUBLIC_BASE_URL=http://localhost:8080

# --- Host ports ---
FRONTEND_PORT=8080
BACKEND_PORT=3000
MAILDEV_WEB_PORT=1080
TARGET_EMULATOR_PORT=4000
